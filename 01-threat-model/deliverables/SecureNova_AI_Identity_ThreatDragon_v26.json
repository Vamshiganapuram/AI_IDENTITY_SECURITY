            "id": "proc-agent",
            "shape": "process",
            "zIndex": 2,
            "position": { "x": 410, "y": 280 },
            "size": { "width": 120, "height": 120 },
            "label": "AI Agent Orchestrator",
            "attrs": {
              "text": { "text": "AI Agent Orchestrator" },
              "body": { "stroke": "#c0392b", "strokeWidth": 2, "strokeDasharray": null }
            },
            "data": {
              "type": "tm.Process",
              "name": "AI Agent Orchestrator",
              "description": "Non-human identity: OBO user JWT + constrained M2M client. Calls REST, RAG, MCP, LLM.",
              "outOfScope": false,
              "reasonOutOfScope": "",
              "isTrustBoundary": false,
              "hasOpenThreats": true,
              "handlesCardPayment": false,
              "handlesGoodsOrServices": false,
              "isWebApplication": true,
              "privilegeLevel": "Delegated user scopes plus constrained tools",
              "threats": [
                {
                  "title": "Spoofed AI agent presents stolen OBO token",
                  "type": "Spoofing",
                  "modelType": "STRIDE",
                  "status": "Open",
                  "severity": "High",
                  "description": "Attacker replays or forges an Auth0 on-behalf-of token so a fake agent calls APIs and MCP tools as a real agent.",
                  "mitigation": "DPoP/cnf binding, short TTL, mTLS, Ed25519 request signing, no implicit agent trust.",
                  "threatId": "t-s",
                  "number": 1,
                  "score": "20"
                },
                {
                  "title": "RAG context or tool arguments tampered",
                  "type": "Tampering",
                  "modelType": "STRIDE",
                  "status": "Open",
                  "severity": "High",
                  "description": "Poisoned chunks or MCP payloads make the agent execute attacker-chosen tools.",
                  "mitigation": "Signed chunks, ingest allow-list, tool schema allow-list.",
                  "threatId": "t-t",
                  "number": 2,
                  "score": "16"
                },
                {
                  "title": "Missing non-human identity audit trail",
                  "type": "Repudiation",
                  "modelType": "STRIDE",
                  "status": "Open",
                  "severity": "Medium",
                  "description": "Agent, MCP, and RAG actions are not bound to a durable actor ID.",
                  "mitigation": "Signed audit events with agent_id, user_sub, client_id, tool name, chunk IDs.",
                  "threatId": "t-r",
                  "number": 3,
                  "score": "12"
                },
                {
                  "title": "Prompt injection discloses LLM API key",
                  "type": "Information disclosure",
                  "modelType": "STRIDE",
                  "status": "Open",
                  "severity": "High",
                  "description": "Direct or indirect prompt injection (OWASP LLM01/LLM07) echoes secrets from env or traces.",
                  "mitigation": "Never put secrets in prompts; vault; short-lived keys; output guardrails.",
                  "threatId": "t-i",
                  "number": 4,
                  "score": "25"
                },
                {
                  "title": "Unbounded tool loops exhaust quotas",
                  "type": "Denial of service",
                  "modelType": "STRIDE",
                  "status": "Open",
                  "severity": "Medium",
                  "description": "Malicious prompt or poisoned chunk causes recursive MCP calls.",
                  "mitigation": "Per-identity rate limits, max tool depth, circuit breakers.",
                  "threatId": "t-d",
                  "number": 5,
                  "score": "12"
                },
                {
                  "title": "Agent elevates to admin API scope",
                  "type": "Elevation of privilege",
                  "modelType": "STRIDE",
                  "status": "Open",
                  "severity": "High",
                  "description": "Confused deputy: M2M client has overlapping admin scopes after spoofing or RAG instruction (LLM09).",
                  "mitigation": "Separate M2M clients, Auth0 RBAC, step-up for privileged tools.",
                  "threatId": "t-e",
                  "number": 6,
                  "score": "20"
                }
              ]
            }
