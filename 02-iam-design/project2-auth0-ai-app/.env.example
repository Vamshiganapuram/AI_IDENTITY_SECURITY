# Copy to .env and fill from the Auth0 dashboard.
# Never commit .env.

AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_API_AUDIENCE=https://securenova-ai-api
AUTH0_SPA_CLIENT_ID=replace_with_spa_client_id

# Machine-to-Machine application (AI agent)
AUTH0_M2M_CLIENT_ID=replace_with_m2m_client_id
AUTH0_M2M_CLIENT_SECRET=replace_with_m2m_client_secret

APP_BASE_URL=http://localhost:8000
PORT=8000
